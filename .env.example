# --- Backend ---
# dev → текстовые логи, prod → JSON
APP_ENV=dev
LOG_LEVEL=info
# json | text; пустое значение выводится из APP_ENV
LOG_FORMAT=
# true добавляет в записи файл и строку вызова (удобно в dev, дороже в prod)
LOG_ADD_SOURCE=false

# Порты публикации в Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- PostgreSQL ---
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=buddy
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- LLM ---
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30s

# --- MCP ---
MCP_ENABLED=false
MCP_URL=
MCP_TIMEOUT=10s

# Для локального запуска backend вне Docker (compose задаёт эти адреса сам).
# Пустое значение отключает соответствующую проверку в /readyz.
# DATABASE_URL=postgres://buddy:buddy@localhost:5432/buddy?sslmode=disable
# REDIS_ADDR=localhost:6379

